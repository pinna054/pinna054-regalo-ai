# =====================================================================
#  Variabili d'ambiente del sito
#
#  In locale: copia questo file in ".env.local" e compila i valori.
#  Su Vercel: Project → Settings → Environment Variables (stessi nomi).
#  Restano tutte sul server: nessuna è visibile nel browser.
# =====================================================================

# --- Motore AI (Anthropic) -------------------------------------------
# Chiave API: https://platform.claude.com → Settings → API Keys
ANTHROPIC_API_KEY=
# Modello usato dal motore (se vuota: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Quanto il modello ragiona prima di rispondere: low, medium, high, xhigh, max (se vuota: medium).
# "nessuno" = non inviare il parametro (per modelli che non lo supportano).
ANTHROPIC_EFFORT=medium
# Versione del prompt usata dal sito: nome di un file nella cartella /prompts, senza ".md"
MOTORE_PROMPT=motore-v1
# 1 = idee FINTE senza chiamare l'AI, per provare il sito senza chiave. MAI in produzione.
MOTORE_FINTO=

# --- Database (Supabase) ---------------------------------------------
# Supabase → pulsante "Connect" → "Transaction pooler": copia la stringa e sostituisci
# [YOUR-PASSWORD] con la password del database. Esempio:
# postgresql://postgres.abcdefghijkl:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Affiliazione Amazon (facoltativa) --------------------------------
# Tag del Programma Affiliazione Amazon per ogni marketplace (es. mionegozio-21).
# Se manca, i link funzionano lo stesso ma senza affiliazione (e senza avviso).
AMAZON_TAG_IT=
AMAZON_TAG_UK=
AMAZON_TAG_DE=
AMAZON_TAG_FR=
AMAZON_TAG_ES=
AMAZON_TAG_US=

# --- Limiti contro gli abusi (facoltativi) -----------------------------
# Richieste di idee per IP all'ora e al giorno, e totale giornaliero di tutto il sito
LIMITE_ORA=10
LIMITE_GIORNO=40
LIMITE_GLOBALE_GIORNO=2000
# Chiave segreta per trasformare gli IP in codici non reversibili:
# una stringa lunga e casuale (consigliata; se manca si usa DATABASE_URL)
SEGRETO_HASH_IP=

# --- Limiti di Gifty, la pagina principale (/api/ai) -----------------
# Chiamate all'AI per utente (IP) all'ora e al giorno, e totale giornaliero del sito.
# Ogni domanda generata e ogni lotto di 6 idee conta 1 (una persona ne usa circa 10).
LIMITE_AI_ORA=40
LIMITE_AI_GIORNO=120
LIMITE_AI_GLOBALE_GIORNO=5000
